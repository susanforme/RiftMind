{
  "name": "riftmind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc && vite build --mode production && bun scripts/check-production.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:mock": "bun scripts/dev-mock.ts",
    "dev:integration": "bun scripts/dev-integration.ts",
    "generate:contracts": "bun scripts/contracts.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run format:check && tsc --noEmit && eslint src scripts tests && bun scripts/check.ts && bun scripts/fixture-manifest.ts --check && bun scripts/contracts.ts --check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:stage1": "bun scripts/verify.ts",
    "check:production": "bun scripts/check-production.ts",
    "verify:stage2": "bun scripts/verify-review.ts",
    "verify:stage3": "bun scripts/verify-scouting.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "i18next": "26.5.2",
    "lucide-react": "1.59.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "17.1.0",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.0.16",
    "vitest": "5.0.5"
  }
}
